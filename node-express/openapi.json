{
  "openapi": "3.0.3",
  "info": {
    "title": "DB Migrator — Client API (Node.js)",
    "version": "1.1.0",
    "description": "瀏覽器 DB Migrator client 的 HTTP API。負責連線測試、匯出 / 匯入、專案備份、排程、外掛商店、跨 DB 預覽。\n\nLicense 由獨立 License Server 管理（見 license-server 的 spec）；本 server 用 LICENSE_MODE env 切 offline / online / disabled。",
    "contact": { "url": "https://github.com/wei820528/db-migrator" },
    "license": { "name": "PolyForm Free Trial 1.0.0" }
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Node 版預設" },
    { "url": "http://localhost:3001", "description": ".NET 版預設" }
  ],
  "tags": [
    { "name": "License",     "description": "授權狀態 / 上 key / online 模式登入" },
    { "name": "Connection",  "description": "測連線 + 列 databases" },
    { "name": "Export",      "description": "Dialect-specific SQL dump" },
    { "name": "Import",      "description": "Inspect SQL + 還原（含 table-subset filter）" },
    { "name": "Jobs",        "description": "Long-running job 追蹤" },
    { "name": "Project",     "description": "Code + DB + Supabase Storage 三層備份 / 還原" },
    { "name": "Schedule",    "description": "排程備份" },
    { "name": "Marketplace", "description": "從 GitHub 一鍵裝 plugin" },
    { "name": "Cross-DB",    "description": "v2 Theme B — 跨 dialect 遷移預覽" },
    { "name": "Webhooks",    "description": "v2 Theme C Phase 4 — HMAC-signed event delivery（job.done / job.failed / schedule.*）" },
    { "name": "Observability","description": "v2 Theme E Phase 1 — Prometheus /metrics + structured /healthz；無 license gate" },
    { "name": "Modules",     "description": "Adapter / route / plugin 健康狀態" },
    { "name": "PluginAudit", "description": "v2 Theme D Phase 4 — sandboxed plugin sensitive-event audit log（require denial / nested worker spawn / route mount / handler error）" }
  ],
  "components": {
    "schemas": {
      "Error":      { "type": "object", "properties": { "error": { "type": "string" } } },
      "ConnectionInfo": {
        "type": "object",
        "properties": {
          "host":     { "type": "string" },
          "port":     { "type": "integer" },
          "user":     { "type": "string" },
          "password": { "type": "string", "format": "password" },
          "database": { "type": "string" },
          "path":     { "type": "string", "description": "SQLite-only" },
          "authMode": { "type": "string", "enum": ["sql", "windows"], "description": "MSSQL-only" },
          "ssl":      { "type": "boolean" }
        }
      },
      "DbType": { "type": "string", "enum": ["mysql", "postgres", "mssql", "sqlite", "supabase", "mongo", "redis"] },
      "TableInfo": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "rowEstimate": { "type": "integer", "nullable": true } }
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "id":      { "type": "string" },
          "kind":    { "type": "string" },
          "status":  { "type": "string", "enum": ["pending", "running", "done", "error"] },
          "log":     { "type": "array", "items": { "type": "string" } },
          "result":  { "type": "object", "additionalProperties": true },
          "error":   { "type": "string", "nullable": true }
        }
      },
      "LicenseStatus": {
        "type": "object",
        "properties": {
          "mode":     { "type": "string", "enum": ["offline", "online", "disabled"] },
          "status":   { "type": "string", "enum": ["licensed", "trial", "free", "expired", "kicked", "offline", "revoked", "disabled"] },
          "daysLeft": { "type": "integer", "nullable": true },
          "info":     { "type": "object", "additionalProperties": true },
          "error":    { "type": "string", "nullable": true }
        }
      },
      "IRType": {
        "type": "object",
        "description": "Cross-DB intermediate representation — column type。",
        "properties": {
          "kind":          { "type": "string", "enum": ["int","float","decimal","string","text","binary","bool","date","time","datetime","json","uuid","enum","unknown"] },
          "size":          { "type": "integer", "nullable": true },
          "precision":     { "type": "integer", "nullable": true },
          "scale":         { "type": "integer", "nullable": true },
          "unsigned":      { "type": "boolean", "nullable": true },
          "fixed":         { "type": "boolean", "nullable": true },
          "timezone":      { "type": "boolean", "nullable": true },
          "values":        { "type": "array", "items": { "type": "string" }, "nullable": true, "description": "enum-only" },
          "autoIncrement": { "type": "boolean", "nullable": true },
          "raw":           { "type": "string", "nullable": true, "description": "unknown kind 才保留原始字串" }
        }
      }
    },
    "responses": {
      "Unauthorized": { "description": "License gate 拒絕（未登入 / 過期 / kicked）" },
      "BadRequest":   { "description": "請求格式錯誤", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound":     { "description": "Not found",   "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "paths": {
    "/api/license": {
      "get": {
        "tags": ["License"], "summary": "查目前 license 狀態（前端 banner 用）",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LicenseStatus" } } } } }
      }
    },
    "/api/license/key": {
      "post": {
        "tags": ["License"], "summary": "（offline）上傳 .key 內容",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["license"], "properties": { "license": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "OK，含 payload 預覽" }, "400": { "description": "簽章 / 格式錯誤" } }
      },
      "delete": {
        "tags": ["License"], "summary": "（offline）移除本機 .key",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/license/revocation/refresh": {
      "post": {
        "tags": ["License"], "summary": "立刻向 License Server 拉新的 revocation list（offline mode 用）",
        "responses": { "200": { "description": "{ ok, error? }" } }
      }
    },
    "/api/license/online/login": {
      "post": {
        "tags": ["License"], "summary": "（online）轉去 License Server 登入 + 開始 heartbeat",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "OK" }, "401": { "description": "認證失敗" } }
      }
    },
    "/api/license/online/logout": {
      "post": {
        "tags": ["License"], "summary": "（online）登出 + 停 heartbeat",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/connection/test": {
      "post": {
        "tags": ["Connection"], "summary": "測連線 + 回 server version + 可看到的 databases",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "allOf": [
            { "$ref": "#/components/schemas/ConnectionInfo" },
            { "type": "object", "required": ["type"], "properties": { "type": { "$ref": "#/components/schemas/DbType" } } }
          ]
        } } } },
        "responses": { "200": { "description": "OK，含 version + databases" } }
      }
    },
    "/api/connection/tables": {
      "post": {
        "tags": ["Connection"], "summary": "列指定 database 內所有 tables",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["type", "connection"],
          "properties": {
            "type":       { "$ref": "#/components/schemas/DbType" },
            "connection": { "$ref": "#/components/schemas/ConnectionInfo" }
          }
        } } } },
        "responses": { "200": { "description": "{ tables: TableInfo[] }" } }
      }
    },
    "/api/export": {
      "post": {
        "tags": ["Export"], "summary": "啟動 dump job",
        "description": "Returns a jobId immediately; poll /api/jobs/{id} for progress / result.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["type", "connection", "databases"],
          "properties": {
            "type":       { "$ref": "#/components/schemas/DbType" },
            "connection": { "$ref": "#/components/schemas/ConnectionInfo" },
            "databases":  { "type": "array", "items": { "type": "string" } },
            "options": {
              "type": "object",
              "properties": {
                "tables":      { "type": "array", "items": { "type": "string" } },
                "noData":      { "type": "boolean" },
                "noSchema":    { "type": "boolean" },
                "encrypt":     { "type": "boolean", "description": "AES-256-GCM encrypt the dump. Password 走 env (DBMIGRATOR_DUMP_PASSWORD by default)" },
                "passwordEnv": { "type": "string",  "description": "Override env var name for dump password (default: DBMIGRATOR_DUMP_PASSWORD)" },
                "s3": {
                  "type": "object",
                  "description": "Upload to S3 after dump (+optional encrypt). AWS creds 走 SDK standard chain。env fallback: S3_BUCKET / S3_PREFIX / S3_REGION / AWS_REGION",
                  "properties": {
                    "bucket":       { "type": "string", "description": "S3 bucket name (必填才會啟動上傳)" },
                    "prefix":       { "type": "string", "description": "Key prefix (default empty)" },
                    "region":       { "type": "string" },
                    "endpoint":     { "type": "string", "description": "Custom S3 endpoint (MinIO / R2)" },
                    "deleteLocal":  { "type": "boolean", "description": "上傳完後砍掉本機檔（純 S3 archive 模式）。預設 false — 保留本機讓 /file 下載仍 work" },
                    "keyPattern":   { "type": "string", "description": "Tokens: {prefix} {dbName} {ts} {ext} {basename}。預設 \"{prefix}{dbName}-{ts}{ext}\"" }
                  }
                }
              }
            }
          }
        } } } },
        "responses": {
          "200": { "description": "{ jobId }" },
          "403": { "description": "License feature gate（bulk_export / multi_db_count_max）" }
        }
      }
    },
    "/api/export/{jobId}/zip": {
      "get": {
        "tags": ["Export"], "summary": "下載多 DB 匯出的 dumps.zip",
        "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "binary zip" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/import/inspect": {
      "post": {
        "tags": ["Import"], "summary": "上傳 SQL 檔 → 回 table 對照（檔內 vs 目標 DB 已存在）。自動偵測 DBMENC 加密檔頭。",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": {
          "type": "object",
          "properties": {
            "file": { "type": "string", "format": "binary" },
            "meta": { "type": "string", "description": "JSON: { type, connection, passwordEnv? }。passwordEnv 給 .enc 檔解密用，預設讀 DBMIGRATOR_DUMP_PASSWORD env" }
          }
        } } } },
        "responses": {
          "200": { "description": "{ uploadId, fileTables, dbTables, diff, encryptedInput }" },
          "400": { "description": "加密檔但 env 沒給 password / 解密失敗" }
        }
      }
    },
    "/api/import/run": {
      "post": {
        "tags": ["Import"], "summary": "執行 import（可選 --tables 子集）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["type", "connection", "uploadId"],
          "properties": {
            "type":       { "$ref": "#/components/schemas/DbType" },
            "connection": { "$ref": "#/components/schemas/ConnectionInfo" },
            "uploadId":   { "type": "string" },
            "tables":     { "type": "array", "items": { "type": "string" } }
          }
        } } } },
        "responses": { "200": { "description": "{ jobId }" } }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": ["Jobs"], "summary": "查 job 狀態 + log",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/project/backup": {
      "post": {
        "tags": ["Project"], "summary": "備份 code (Git) + DB + Supabase Storage 三層到 backup.zip",
        "responses": { "200": { "description": "{ jobId }" }, "403": { "description": "License feature gate（project_backup）" } }
      }
    },
    "/api/project/restore": {
      "post": {
        "tags": ["Project"], "summary": "從 backup.zip 還原",
        "responses": { "200": { "description": "{ jobId }" } }
      }
    },
    "/api/schedule": {
      "get": {
        "tags": ["Schedule"], "summary": "列所有排程備份",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Schedule"], "summary": "新增排程備份",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["name", "expr", "type", "connection", "databases"],
          "properties": {
            "name":       { "type": "string" },
            "expr":       { "type": "string", "description": "例：'every 6 hours' / 'daily at 02:00' / 'every 30 minutes'" },
            "type":       { "$ref": "#/components/schemas/DbType" },
            "connection": { "$ref": "#/components/schemas/ConnectionInfo" },
            "databases":  { "type": "array", "items": { "type": "string" } },
            "active":     { "type": "boolean", "default": true },
            "retentionCount": { "type": "integer", "description": "保留最新 N 份歷史，0=不限。跟 retentionDays 是聯集（任一條 trigger 就砍）" },
            "retentionDays":  { "type": "integer", "description": "保留最近 N 天歷史，0=不限" }
          }
        } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/schedule/{id}": {
      "patch": {
        "tags": ["Schedule"], "summary": "改排程",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Schedule"], "summary": "刪排程",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/schedule/{id}/run-now": {
      "post": {
        "tags": ["Schedule"], "summary": "立刻跑一次",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ jobId }" } }
      }
    },
    "/api/schedule/{id}/history": {
      "get": {
        "tags": ["Schedule"], "summary": "列該 schedule 的所有歷史備份檔（time-travel 用）",
        "description": "Phase 4 — 每個 schedule 的輸出放在 scheduled-backups/{sched-id}/，這個 endpoint 列該目錄裡所有檔，DESC by mtime。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ scheduleId, scheduleName, retention, items: [{ name, sizeBytes, mtime, encrypted }] }" } }
      }
    },
    "/api/schedule/{id}/restore": {
      "post": {
        "tags": ["Schedule"], "summary": "從歷史檔還原 — time-travel restore",
        "description": "選擇 schedule 的某份歷史 dump，restore 到原 connection 或指定 target。.enc 檔自動 streaming decrypt（需 DBMIGRATOR_DUMP_PASSWORD env）。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["historyName"],
          "properties": {
            "historyName": { "type": "string", "description": "從 /api/schedule/{id}/history 拿到的 name" },
            "target": {
              "type": "object",
              "description": "Override target — 沒給就用原 schedule 的 connection + 第一個 database",
              "properties": {
                "type":       { "$ref": "#/components/schemas/DbType" },
                "connection": { "$ref": "#/components/schemas/ConnectionInfo" },
                "database":   { "type": "string" }
              }
            },
            "passwordEnv": { "type": "string", "description": "override env var name for decrypt (default DBMIGRATOR_DUMP_PASSWORD)" }
          }
        } } } },
        "responses": {
          "200": { "description": "{ jobId } — async；poll /api/jobs/{id}" },
          "400": { "description": "history file not found / path traversal blocked / encrypted but no password" }
        }
      }
    },
    "/api/schedule/{id}/history/{name}": {
      "delete": {
        "tags": ["Schedule"], "summary": "刪除單一歷史備份檔",
        "parameters": [
          { "name": "id",   "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" }, "description": "history file name (不可含 / .. \\)" }
        ],
        "responses": { "200": { "description": "{ ok: true }" }, "400": { "description": "bad name / not found" } }
      }
    },
    "/api/marketplace/preview": {
      "post": {
        "tags": ["Marketplace"], "summary": "預覽 GitHub repo 上的 plugin（驗 SHA-256 + Ed25519 簽章）",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } }
        } } } },
        "responses": {
          "200": { "description": "{ source, manifest, signature, files }" },
          "400": { "description": "URL 不是 github.com / manifest 損壞 / hash 不符" }
        }
      }
    },
    "/api/marketplace/install": {
      "post": {
        "tags": ["Marketplace"], "summary": "安裝 plugin（atomic：staging dir → rename）",
        "description": "v2 Theme D Phase 1: 可選 `grantedPermissions` 是 user 同意的 subset；省略則 default 全部 grant。Granted set 寫到 `<plugin>/.granted-permissions.json`。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["url"],
          "properties": {
            "url":                { "type": "string", "format": "uri" },
            "allowUnsigned":      { "type": "boolean", "default": false },
            "grantedPermissions": { "type": "array", "items": { "type": "string" }, "description": "Subset of manifest.permissions the user explicitly grants" }
          }
        } } } },
        "responses": { "200": { "description": "{ ok, installed, version, fileCount, signed, trusted, permissions: { requested, granted, legacy } }" } }
      }
    },
    "/api/marketplace/permissions": {
      "get": {
        "tags": ["Marketplace"], "summary": "v2 Theme D — 取得 permission catalog（label / description / risk）",
        "responses": { "200": { "description": "{ permissions: { id: { label, description, risk } } }" } }
      }
    },
    "/api/marketplace/installed": {
      "get": {
        "tags": ["Marketplace"], "summary": "已安裝的 plugin 清單",
        "responses": { "200": { "description": "{ plugins: [{ name, version, signed, permissions: { requested, granted, legacy } | null }] }" } }
      }
    },
    "/api/marketplace/trusted": {
      "get": {
        "tags": ["Marketplace"], "summary": "信任的 publisher 清單（含 fingerprint，不含 PEM）",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Marketplace"], "summary": "新增 trusted publisher",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["id", "pem"], "properties": { "id": { "type": "string" }, "pem": { "type": "string" } }
        } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/cross-db/preview-live": {
      "post": {
        "tags": ["Cross-DB"], "summary": "Dry-run：用 source.getSchema() 預測 target dialect 的 CREATE TABLE + warnings",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["sourceType", "sourceConn", "targetType"],
          "properties": {
            "sourceType": { "type": "string", "enum": ["mysql", "postgres", "sqlite", "supabase"] },
            "sourceConn": { "$ref": "#/components/schemas/ConnectionInfo" },
            "targetType": { "type": "string", "enum": ["mysql", "postgres", "sqlite", "supabase"] },
            "tables":     { "type": "array", "items": { "type": "string" } }
          }
        } } } },
        "responses": {
          "200": { "description": "{ source, target, tableCount, warningCount, tables: [...] }" },
          "400": { "description": "不支援的 dialect / source 與 target 相同" }
        }
      }
    },
    "/api/webhooks": {
      "get": {
        "tags": ["Webhooks"], "summary": "列出 webhooks + 所有可訂閱的事件",
        "responses": { "200": { "description": "{ webhooks: [...], events: [...] }" } }
      },
      "post": {
        "tags": ["Webhooks"], "summary": "建立 webhook",
        "description": "Response 含 `secret`（whsec_…）— **僅此一次** 拿得到，請存到 secret store。\nReceiver 端驗章方式：`X-DBMigrator-Signature: sha256=<hex of HMAC-SHA256(secret, raw_body)>`。",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["name", "url", "events"],
          "properties": {
            "name":   { "type": "string", "maxLength": 64 },
            "url":    { "type": "string", "format": "uri", "description": "http:// or https://" },
            "events": { "type": "array", "items": { "type": "string" }, "description": "見 GET /api/webhooks 的 events 陣列。`*` 訂閱全部" }
          }
        } } } },
        "responses": {
          "200": { "description": "{ id, name, url, events, secret, secret_prefix }" },
          "400": { "description": "URL / events 不合法" }
        }
      }
    },
    "/api/webhooks/{id}": {
      "patch": {
        "tags": ["Webhooks"], "summary": "更新（name / url / events / active）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["Webhooks"], "summary": "刪除 webhook",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/webhooks/{id}/test": {
      "post": {
        "tags": ["Webhooks"], "summary": "Test-ping — 立刻送一個 `ping` 事件，方便驗收 receiver 是否能收到 + 驗章",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "{ ok, status, attempt } 或 { ok:false, error, attempts }" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Observability"],
        "summary": "Prometheus exposition format（text/plain）",
        "description": "v2 Theme E Phase 1。預設 metrics：\n- `dbmigrator_jobs_total{kind,status}` (counter) — 累計 jobs 數\n- `dbmigrator_webhook_deliveries_total{event,status}` (counter)\n- `dbmigrator_plugin_status{plugin}` (gauge 0/1)\n- `dbmigrator_module_status{module}` (gauge 0/1)\n- `dbmigrator_uptime_seconds` (gauge)\n\n**不在 license gate 內** — 給 Prometheus scraper 用，license 過期不會影響 scrape。",
        "responses": {
          "200": {
            "description": "Prometheus text exposition (text/plain; version=0.0.4)",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "500": { "description": "metrics module error" }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Observability"],
        "summary": "Component-based health check（替代舊的 /api/health）",
        "description": "v2 Theme E Phase 1。回 200 全健康、503 任一 component 失敗（給 k8s liveness probe / LB / Uptime monitor 用）。**不在 license gate 內**。\n\n檢查的 components：\n- `jobs_db` / `schedules_db` / `webhooks_db` — SQLite 檔存在性 + size + mtime\n- `adapters` — adapter registry 狀態，列出 failed 的名字\n- `license` — license gate 狀態（disabled / licensed / trial / free 算健康）",
        "responses": {
          "200": {
            "description": "All components healthy",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "ok": { "type": "boolean" },
                "uptime": { "type": "number" },
                "version": { "type": "string" },
                "components": { "type": "object", "additionalProperties": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                } }
              }
            } } }
          },
          "503": { "description": "One or more components unhealthy（same shape as 200，ok: false）" }
        }
      }
    },
    "/api/modules": {
      "get": {
        "tags": ["Modules"], "summary": "所有 route + adapter + plugin 的健康狀態",
        "responses": { "200": { "description": "{ routes: {}, adapters: {}, plugins: {} }" } }
      }
    },
    "/api/plugin-audit": {
      "get": {
        "tags": ["PluginAudit"],
        "summary": "Sandboxed plugin sensitive-event audit log",
        "description": "Phase 4 — 列出 sandboxed plugin 觸發的 audit events：`require-denied`（plugin 想 require 沒授權的 builtin）、`worker-spawn-attempt`（plugin 想 spawn 子 worker 逃 sandbox）、`route-mount`（plugin 註冊 endpoint）、`handler-error`（plugin handler throw）。",
        "parameters": [
          { "name": "plugin",      "in": "query", "schema": { "type": "string" }, "description": "filter by plugin name" },
          { "name": "event",       "in": "query", "schema": { "type": "string", "enum": ["require-denied", "worker-spawn-attempt", "route-mount", "handler-error"] } },
          { "name": "since",       "in": "query", "schema": { "type": "integer" }, "description": "unix ms epoch — 只取這之後的" },
          { "name": "minSeverity", "in": "query", "schema": { "type": "string", "enum": ["info", "warn", "error"] } },
          { "name": "limit",       "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 1000 } }
        ],
        "responses": { "200": { "description": "{ items: [{ id, ts, pluginName, eventType, severity, detail }], count }" } }
      }
    },
    "/api/plugin-audit/count": {
      "get": {
        "tags": ["PluginAudit"], "summary": "只回筆數（dashboard 用，不拉 items）",
        "parameters": [
          { "name": "plugin", "in": "query", "schema": { "type": "string" } },
          { "name": "event",  "in": "query", "schema": { "type": "string" } },
          { "name": "since",  "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "{ count: integer }" } }
      }
    },
    "/api/plugin-audit/prune": {
      "post": {
        "tags": ["PluginAudit"], "summary": "砍舊紀錄",
        "requestBody": { "content": { "application/json": { "schema": {
          "type": "object",
          "properties": { "olderThanDays": { "type": "integer", "default": 30 } }
        } } } },
        "responses": { "200": { "description": "{ deleted: N }" } }
      }
    },
    "/api/plugins/ui": {
      "get": {
        "tags": ["Modules"], "summary": "Plugin 貢獻的 UI cards / tabs / scripts（前端動態載入）",
        "responses": { "200": { "description": "{ cards: [...], tabs: [...], scripts: [...] }" } }
      }
    }
  }
}
